# 1. Groq API Key (مجاني - 30 طلب/دقيقة)
# احصل عليه من: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini API Key (مجاني - 1500 طلب/يوم)
# احصل عليه من: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# 3. OpenRouter API Key (مجاني - بوابة لـ 100+ نموذج)
# احصل عليه من: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
